<?xml version="1.0" encoding="utf-8"?>
<!-- The Google Play edition -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Play updates the app, so it doesn't ask to install apps itself (Play doesn't allow that) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <application>
        <!-- The media bar's song and artwork: only so notification access can be given, which lets it see what's playing. In the
             Play edition only: Play Protect blocks apps that ask for notification access when they're installed from a file
             (GitHub, desko1973), so the GitHub edition's media bar has the buttons without the song -->
        <service
            android:name="com.headunit.launcher.MediaListener"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
