// Copy this file to Secrets.xcconfig in the same folder and add your own keys.
// Secrets.xcconfig is ignored by git, so the keys never reach the repository.
// Keys typed into the app's Settings are stored in the Keychain and take priority.

// Mapbox default public token, from account.mapbox.com > Tokens (starts with pk.)
HN_MAPBOX_ACCESS_TOKEN =

// TomTom API key with the Routing and Search APIs, from developer.tomtom.com
HN_TOMTOM_API_KEY =
